# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
.test-backups/
backend/*.db

# Node / Expo (mobile/ has its own .gitignore from the template)
node_modules/

# Env
.env

# Release builds (kept locally / attached to GitHub releases, not committed)
*.apk
*.aab

# Signing keys and Play credentials. These live outside the repo, under
# %USERPROFILE%\.rozakos-release\ - these patterns are a second line of defence.
*.jks
*.keystore
play-service-account*.json
signing.properties
