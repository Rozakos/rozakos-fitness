{
  "expo": {
    "name": "Rozakos Fitness",
    "slug": "rozakos-fitness",
    "version": "1.9.0",
    "orientation": "portrait",
    "icon": "./assets/store/icon.png",
    "scheme": "rozakosfitness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/store/icon.png"
    },
    "android": {
      "package": "com.rozakos.fitness",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2c2c3e",
        "foregroundImage": "./assets/store/adaptive-foreground.png",
        "monochromeImage": "./assets/store/monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/store/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2c2c3e",
          "image": "./assets/store/splash.png",
          "imageWidth": 76
        }
      ],
      "./plugins/with-upload-signing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
