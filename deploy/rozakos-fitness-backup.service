[Unit]
Description=Back up the Rozakos Fitness SQLite database
After=rozakos-fitness.service

[Service]
Type=oneshot
User=rozakos-fitness
Group=rozakos-fitness
ExecStart=/opt/rozakos-fitness/.venv/bin/python /opt/rozakos-fitness/deploy/backup_sqlite.py /var/lib/rozakos-fitness/fitness.db /var/backups/rozakos-fitness --keep 30
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/rozakos-fitness
ReadWritePaths=/var/backups/rozakos-fitness
